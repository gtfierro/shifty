-- vav.shm with a typo, for the tutorial: `exactl` for `exactly`.
base <urn:example/tutorial/>
prefix brick: <https://brickschema.org/schema/Brick#>

doc "A VAV box: fed by one AHU, with an airflow sensor and a damper."
shape vav for every brick:VAV {
  fed: brick:isFedBy exactl 1, each a brick:AHU
  flow: brick:hasPoint at least 1 is a brick:Air_Flow_Sensor
  damper: brick:hasPart at least 1 matches damper
}

doc "A damper that can be commanded to a position."
shape damper {
  is a brick:Damper
  brick:hasPoint at least 1 is a brick:Damper_Position_Command
}
