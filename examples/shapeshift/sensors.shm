-- Reusable sensor shapes, imported by hvac.shm as `sensors`.
base   <https://example.org/shapes/sensors>
prefix brick: <https://brickschema.org/schema/Brick#>
prefix unit: <http://qudt.org/vocab/unit/>

doc "A point that reports a measurement in a known unit."
shape Sensor {
  typed: rdf:type required
  brick:hasUnit optional, each iri
}

shape TempSensor {
  include Sensor
  brick:hasUnit each one of unit:DEG_C unit:DEG_F
}
