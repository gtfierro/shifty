-- ASHRAE Guideline 36-2021, 4.4: dual-duct terminal unit with inlet sensors.
-- Translated from BuildingMOTIF's
-- libraries/ashrae/guideline36/4.4-dual-duct-terminal-unit-with-inlet.ttl.
base <urn:ashrae/g36/4.4/dual-duct-terminal-unit-with-inlet-sensors/>
import "./brick.shm"
import "./components.shm" as components
import "./4.1-vav-cooling-only.shm" as vav41
prefix brick: <https://brickschema.org/schema/Brick#>

doc "4.4 Dual-duct terminal unit with inlet sensors"
shape terminal-unit {
  is brick:Terminal_Unit
  parts {
    hot_deck:  hot-deck
    cold_deck: cold-deck
  }
  points optional {
    override:    brick:Override_Command
    temp_adjust: brick:Temperature_Adjust_Sensor
  }
  vav41.zone-temperature
  vav41.zone-co2-level
  vav41.occupancy-sensor
}

shape hot-deck {
  is brick:Hot_Deck
  components.heating_damper
  points { sa_flow: brick:Supply_Air_Flow_Sensor }
}

shape cold-deck {
  is brick:Cold_Deck
  components.cooling_damper
  points { sa_flow: brick:Supply_Air_Flow_Sensor }
}
