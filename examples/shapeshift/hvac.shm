-- The worked example from the Shapeshift design, made self-contained:
-- it imports its sensor vocabulary from sensors.shm.
base <https://example.org/shapes/hvac>
import "./sensors.shm" as sensors
prefix brick: <https://brickschema.org/schema/Brick#>
prefix ex: <https://example.org/building#>

shape HasPointOf(cls) { brick:hasPoint at least 1 is a cls }

doc "A VAV must report supply-air temperature and be fed by exactly one AHU or RTU."
shape VAV for every brick:VAV {
  HasPointOf(brick:Supply_Air_Temperature_Sensor)
  brick:hasPoint each matches sensors.Sensor
  doc "Dual-duct VAVs are modelled as two VAVs."
  message "A VAV must be fed by exactly one AHU or RTU."
  fedBy: brick:isFedBy exactly 1, each a brick:AHU or brick:RTU
  unit: brick:hasUnit optional, each one of brick:Degree_Celsius brick:Degree_Fahrenheit
  commissioned: ex:commissioned optional, each date, each from 2000-01-01
  when { brick:hasPoint at least 1 is a brick:Economizer_Status }
  then { brick:hasPoint at least 1 is a brick:Outside_Air_Damper }
}

shape ReheatVAV for every brick:RVAV {
  VAV.fedBy  -- one named field, not the whole shape
  reheat: brick:hasPoint at least 1 is a brick:Reheat_Valve_Command
}

shape Space for every brick:Space {
  brick:hasPart each matches Space
  only these properties  -- besides rdf:type
}

shape Zone for every brick:HVAC_Zone {
  severity warning
  temp: brick:hasPoint at least 1 is a brick:Zone_Air_Temperature_Sensor
  at least 2 of { brick:hasPart required }
                { brick:isPartOf required }
                { brick:feeds required }
  exactly one of { brick:hasTag required } { rdfs:label required, each string }
  none of { brick:hasLocation required }
}
