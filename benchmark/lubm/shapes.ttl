@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ub:   <http://swat.cse.lehigh.edu/onto/univ-bench.owl#> .
@prefix ubsh: <http://shifty.dev/lubm/shapes#> .

# SHACL shapes over the LUBM (Lehigh University Benchmark) univ-bench ontology.
#
# LUBM ships an OWL ontology and a data generator, not shapes — its own queries
# are SPARQL. These shapes give the generator's output something to validate
# against, chosen so the suite exercises the constructs whose evidence differs
# in kind, at a data size the generator can dial up arbitrarily:
#
#   * class membership through the hierarchy (`sh:class` compiles to
#     `type · subClassOf*`, so these traverse univ-bench's taxonomy);
#   * cardinality in both directions (`sh:minCount` under-satisfaction produces
#     `CountLow` evidence, `sh:maxCount` over-satisfaction produces `CountHigh`);
#   * qualified cardinality, whose evidence partitions candidates into
#     qualifying matches and rejected candidates;
#   * datatype and node-kind leaves, which produce `Atom` evidence;
#   * disjunction (`sh:or`), whose satisfaction retains held branches and whose
#     failure retains every branch;
#   * negation (`sh:not`), which crosses to the opposite evidence polarity;
#   * a universal (`sh:path` + `sh:node` with no cardinality), vacuously true on
#     an empty path — the case that produces `ForAllHeld` satisfaction.
#
# Generated LUBM data conforms to the ontology but not to all of these: the
# generator omits `ub:emailAddress` and `ub:telephone` on some staff, leaves
# some publications authorless, and assigns undergraduate degrees from
# universities it never describes. Those are deliberate — a corpus on which
# everything passes exercises only the satisfaction half of the interface.

ubsh:UniversityShape a sh:NodeShape ;
    sh:targetClass ub:University ;
    sh:property [
        sh:path ub:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

ubsh:DepartmentShape a sh:NodeShape ;
    sh:targetClass ub:Department ;
    sh:property [
        sh:path ub:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    # Every department belongs to exactly one university.
    sh:property [
        sh:path ub:subOrganizationOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ub:University ;
    ] .

ubsh:CourseShape a sh:NodeShape ;
    sh:targetClass ub:Course ;
    sh:property [
        sh:path ub:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

# Faculty: contact details plus a teaching load. `sh:or` over the degree
# properties exercises disjunction on both polarities.
ubsh:FacultyShape a sh:NodeShape ;
    sh:targetClass ub:Faculty ;
    sh:property [
        sh:path ub:name ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ub:worksFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path ub:emailAddress ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ub:telephone ;
        sh:minCount 1 ;
    ] ;
    sh:or (
        [ sh:path ub:doctoralDegreeFrom ; sh:minCount 1 ]
        [ sh:path ub:mastersDegreeFrom  ; sh:minCount 1 ]
    ) .

# Professors teach at least one course, and every course they teach must be a
# Course. The second constraint carries no cardinality, so it is vacuously
# satisfied on an empty path — the `ForAllHeld` case.
ubsh:ProfessorShape a sh:NodeShape ;
    sh:targetClass ub:Professor ;
    sh:property [
        sh:path ub:teacherOf ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ub:teacherOf ;
        sh:class ub:Course ;
    ] .

# A full professor heads at most one department: `sh:maxCount` over-satisfaction
# is the `CountHigh` case.
ubsh:FullProfessorShape a sh:NodeShape ;
    sh:targetClass ub:FullProfessor ;
    sh:property [
        sh:path ub:headOf ;
        sh:maxCount 1 ;
    ] .

ubsh:GraduateStudentShape a sh:NodeShape ;
    sh:targetClass ub:GraduateStudent ;
    sh:property [
        sh:path ub:name ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ub:takesCourse ;
        sh:minCount 1 ;
        sh:class ub:GraduateCourse ;
    ] ;
    sh:property [
        sh:path ub:undergraduateDegreeFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ub:University ;
    ] ;
    # Advisor must be faculty — qualified membership through the hierarchy.
    sh:property [
        sh:path ub:advisor ;
        sh:minCount 1 ;
        sh:class ub:Faculty ;
    ] .

ubsh:UndergraduateStudentShape a sh:NodeShape ;
    sh:targetClass ub:UndergraduateStudent ;
    sh:property [
        sh:path ub:takesCourse ;
        sh:minCount 1 ;
    ] ;
    # An undergraduate does not hold a doctoral degree: negation crosses to the
    # opposite evidence polarity.
    sh:not [
        sh:path ub:doctoralDegreeFrom ;
        sh:minCount 1 ;
    ] .

# Qualified cardinality: at least one author who is a Professor. Evidence
# partitions the authors into qualifying matches and rejected candidates.
ubsh:PublicationShape a sh:NodeShape ;
    sh:targetClass ub:Publication ;
    sh:property [
        sh:path ub:publicationAuthor ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ub:publicationAuthor ;
        sh:qualifiedValueShape [ sh:class ub:Professor ] ;
        sh:qualifiedMinCount 1 ;
    ] .

ubsh:ResearchGroupShape a sh:NodeShape ;
    sh:targetClass ub:ResearchGroup ;
    sh:property [
        sh:path ub:subOrganizationOf ;
        sh:minCount 1 ;
        sh:class ub:Department ;
    ] .
